<?xml version="1.0"?>
<package format="3">
  <name>px4_square</name>
  <version>0.1.0</version>
  <description>
    The organisers' example square (hover 1.0 m, 0.5 m square, hold), using PX4's local
    position for the start, targets and arrival instead of VIO. No depth camera.
  </description>
  <maintainer email="noreply@example.com">team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>skybeta_flight_interface</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
