<?xml version="1.0"?>
<package format="3">
  <name>px4_route</name>
  <version>0.1.0</version>
  <description>
    Waypoint route follower on PX4's local position: the px4_square stack (flew cleanly, PX4
    log 26) with the route read from a YAML file and a speed-limited carrot setpoint.
  </description>
  <maintainer email="noreply@example.com">team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>skybeta_flight_interface</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
