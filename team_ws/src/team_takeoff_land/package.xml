<?xml version="1.0"?>
<package format="3">
  <name>team_takeoff_land</name>
  <version>0.1.0</version>
  <description>
    Takeoff / land services between the team planner and the skybeta flight
    interface. While taking off, hovering or landing, planner setpoints are
    dropped. Landing uses PX4 NAV_LAND; this node never arms.
  </description>
  <maintainer email="lucaskniska1@gmail.com">LucasKniska</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>skybeta_flight_interface</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
